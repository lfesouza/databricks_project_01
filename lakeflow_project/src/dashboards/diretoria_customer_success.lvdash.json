{
  "datasets": [
    {
      "name": "ds_clientes",
      "displayName": "Clientes (uma linha por cliente)",
      "queryLines": [
        "SELECT\n",
        "  ranking_receita,\n",
        "  id_cliente,\n",
        "  nome_cliente,\n",
        "  estado,\n",
        "  nome_estado,\n",
        "  regiao,\n",
        "  segmento_cliente,\n",
        "  total_compras,\n",
        "  receita,\n",
        "  ticket_medio,\n",
        "  ultima_compra,\n",
        "  CASE WHEN segmento_cliente = 'VIP' THEN 1 ELSE 0 END AS cliente_vip,\n",
        "  CASE WHEN segmento_cliente = 'VIP' THEN receita ELSE 0 END AS receita_vip\n",
        "FROM clientes_segmentacao\n",
        "ORDER BY ranking_receita\n"
      ],
      "columns": [
        {
          "displayName": "Ticket médio",
          "description": "Receita total ÷ total de compras (nunca média de médias)",
          "expression": "SUM(`receita`) / SUM(`total_compras`)"
        },
        {
          "displayName": "% receita VIP",
          "description": "Receita dos clientes VIP ÷ receita total (0 a 1)",
          "expression": "SUM(`receita_vip`) / SUM(`receita`)"
        }
      ]
    }
  ],
