{
  "datasets": [
    {
      "name": "ds_precos",
      "displayName": "Preços x concorrência (uma linha por produto)",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  CASE classificacao_preco\n",
        "    WHEN 'MAIS_CARO_QUE_TODOS' THEN 'Mais caro que todos'\n",
        "    WHEN 'ACIMA_DA_MEDIA' THEN 'Acima da média'\n",
        "    WHEN 'NA_MEDIA' THEN 'Na média'\n",
        "    WHEN 'ABAIXO_DA_MEDIA' THEN 'Abaixo da média'\n",
        "    WHEN 'MAIS_BARATO_QUE_TODOS' THEN 'Mais barato que todos'\n",
        "    ELSE classificacao_preco\n",
        "  END AS classificacao,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Preço a conferir' ELSE 'Confirmado' END AS situacao,\n",
        "  CASE WHEN possui_preco_suspeito THEN 1 ELSE 0 END AS preco_suspeito,\n",
        "  CASE WHEN classificacao_preco = 'MAIS_CARO_QUE_TODOS' AND NOT possui_preco_suspeito THEN 1 ELSE 0 END AS caro_confirmado,\n",
        "  CASE WHEN classificacao_preco = 'MAIS_CARO_QUE_TODOS' AND NOT possui_preco_suspeito THEN receita ELSE 0 END AS receita_caro_confirmado,\n",
        "  receita\n",
        "FROM precos_competitividade\n"
      ]
    },
    {
      "name": "ds_categoria_confirmados",
      "displayName": "Diferença vs. mercado por categoria (sem preços suspeitos)",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  categoria,\n",
        "  CASE classificacao_preco\n",
        "    WHEN 'MAIS_CARO_QUE_TODOS' THEN 'Mais caro que todos'\n",
        "    WHEN 'ACIMA_DA_MEDIA' THEN 'Acima da média'\n",
        "    WHEN 'NA_MEDIA' THEN 'Na média'\n",
        "    WHEN 'ABAIXO_DA_MEDIA' THEN 'Abaixo da média'\n",
        "    WHEN 'MAIS_BARATO_QUE_TODOS' THEN 'Mais barato que todos'\n",
        "    ELSE classificacao_preco\n",
        "  END AS classificacao,\n",
        "  diferenca_pct_vs_media / 100 AS diferenca_vs_media\n",
        "FROM precos_competitividade\n",
        "WHERE NOT possui_preco_suspeito\n"
      ]
    },
    {
      "name": "ds_acao",
      "displayName": "Produtos mais caros que todos os concorrentes",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  CASE classificacao_preco\n",
        "    WHEN 'MAIS_CARO_QUE_TODOS' THEN 'Mais caro que todos'\n",
        "    WHEN 'ACIMA_DA_MEDIA' THEN 'Acima da média'\n",
        "    WHEN 'NA_MEDIA' THEN 'Na média'\n",
        "    WHEN 'ABAIXO_DA_MEDIA' THEN 'Abaixo da média'\n",
        "    WHEN 'MAIS_BARATO_QUE_TODOS' THEN 'Mais barato que todos'\n",
        "    ELSE classificacao_preco\n",
        "  END AS classificacao,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_minimo_concorrentes,\n",
        "  diferenca_pct_vs_media / 100 AS diferenca_vs_media,\n",
        "  diferenca_pct_vs_minimo / 100 AS diferenca_vs_minimo,\n",
        "  receita,\n",
        "  itens_vendidos,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar\n",
        "FROM precos_competitividade\n",
        "WHERE classificacao_preco = 'MAIS_CARO_QUE_TODOS'\n",
        "ORDER BY receita DESC, id_produto\n"
      ]
    }
  ],
