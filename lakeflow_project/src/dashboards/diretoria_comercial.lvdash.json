{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (uma linha por venda)",
      "queryLines": [
        "SELECT\n",
        "  id_venda,\n",
        "  data,\n",
        "  dia_semana,\n",
        "  dia_semana_num,\n",
        "  hora,\n",
        "  CONCAT(LPAD(CAST(hora AS STRING), 2, '0'), 'h') AS hora_rotulo,\n",
        "  CASE canal_venda WHEN 'ecommerce' THEN 'E-commerce' WHEN 'loja_fisica' THEN 'Loja física' ELSE canal_venda END AS canal,\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  quantidade,\n",
        "  receita\n",
        "FROM vendas_detalhadas\n"
      ],
      "columns": [
        {
          "displayName": "Ticket médio",
          "description": "Receita total ÷ número de vendas (nunca média de médias)",
          "expression": "SUM(`receita`) / COUNT(`id_venda`)"
        },
        {
          "displayName": "Receita média por dia",
          "description": "Receita ÷ dias com venda; compara dias da semana com quantidades diferentes de ocorrências no período",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `data`)"
        }
      ]
    },
    {
      "name": "ds_top10",
      "displayName": "Top 10 produtos por receita",
      "queryLines": [
        "WITH vendas AS (\n",
        "  SELECT\n",
        "    id_produto,\n",
        "    nome_produto,\n",
        "    categoria,\n",
        "    CASE canal_venda WHEN 'ecommerce' THEN 'E-commerce' WHEN 'loja_fisica' THEN 'Loja física' ELSE canal_venda END AS canal,\n",
        "    data,\n",
        "    quantidade,\n",
        "    receita\n",
        "  FROM vendas_detalhadas\n",
        ")\n",
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  COUNT(*) AS vendas,\n",
        "  SUM(quantidade) AS itens_vendidos,\n",
        "  SUM(receita) AS receita,\n",
        "  CAST(SUM(receita) / COUNT(*) AS DECIMAL(10,2)) AS ticket_medio\n",
        "FROM vendas\n",
        "WHERE data BETWEEN :periodo.min AND :periodo.max\n",
        "  AND (size(:canal) = 0 OR array_contains(:canal, canal))\n",
        "GROUP BY id_produto, nome_produto, categoria\n",
        "ORDER BY receita DESC, id_produto\n",
        "LIMIT 10\n"
      ],
      "parameters": [
        {
          "displayName": "periodo",
          "keyword": "periodo",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-12-13"
              },
              "max": {
                "value": "2026-01-11"
              }
            }
          }
        },
        {
          "displayName": "canal",
          "keyword": "canal",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          }
        }
      ]
    }
  ],
